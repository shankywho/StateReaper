# ─────────────────────────────────────────────────────────────
# StateReaper FinOps — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Switch Protocol ──────────────────────────────────────────
# The base URL of your self-hosted Switch server (SSE endpoint)
SWITCH_SERVER_URL=http://localhost:8080
# The Switch room ID to subscribe to (set after room creation)
SWITCH_ROOM_ID=statereaper-tribunal
# API key / bearer token for Switch authentication
SWITCH_API_KEY=your-switch-api-key-here

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ── AWS (STRICTLY REQUIRED when USE_MOCK_TELEMETRY=false) ────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# ── Vercel (STRICTLY REQUIRED when USE_MOCK_TELEMETRY=false) ─
VERCEL_API_TOKEN=your-vercel-api-token
VERCEL_TEAM_ID=your-vercel-team-id

# ── Application ──────────────────────────────────────────────
# Set to "false" to enable live AWS CloudWatch / EC2 and Vercel REST APIs.
# Set to "true" to run with local mock telemetry (default for local judging).
USE_MOCK_TELEMETRY=true
# Set to "true" to print all Switch room POSTs to stdout (no Switch server needed)
SWITCH_DRY_RUN=true
# Path for the append-only JSON audit log
AUDIT_LOG_PATH=./audit-logs/audit.jsonl
# Polling interval for the cost-telemetry agent (milliseconds)
TELEMETRY_POLL_INTERVAL_MS=60000
# CPU % threshold below which a resource is considered idle
IDLE_CPU_THRESHOLD_PERCENT=0.1
# Idle duration threshold (hours) before flagging a resource
IDLE_DURATION_THRESHOLD_HOURS=48
